# 复制为 .env 并填写。真实 Key 绝不提交到仓库，也绝不出现在日志/README 中。
# Phase 0~6 默认 NO_PAID_API=true；真实 API 仅 Phase 7 live evaluation 使用。
DEEPSEEK_API_KEY=

# 可选覆盖项（默认值见 app/config.py）
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/agent_cs
# NO_PAID_API=true
# EMBEDDING_BACKEND=fake   # fake | bge
# NO_PAID_API=false 时启动即校验：DEEPSEEK_API_KEY、DEEPSEEK_BASE_URL（公网须 https）、MODEL_NAME、JWT_SECRET（非默认）缺一拒绝启动
# JWT_SECRET=
# LLM_MAX_RETRIES=2               # 只重试 429 / 5xx / 连接失败 / 连接超时
# LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_READ_TIMEOUT_SECONDS=60     # 读超时不重试（请求可能已计费），usage 按上限计入
# BGE 模型来源：默认官方 huggingface.co；镜像需显式配置 HF_ENDPOINT；本地目录 + 离线模式不联网
# HF_ENDPOINT=
# BGE_MODEL_PATH=
# HF_HUB_OFFLINE=1
