# 复制为 .env 并填写。真实 Key 绝不提交到仓库，也绝不出现在日志/README 中
# （DEEPSEEK_API_KEY 是 pydantic SecretStr：配置对象被打印/报错时只显示 **********）。
# 密钥管理约定：所有密钥只从环境变量 / .env / secret 文件注入；不打进镜像层，不写进日志或报告。
# 逐项含义、是否必需、默认值见下（默认值为空的一行表示留空 = 用代码里的默认值，见 app/config.py）。

# ============ 数据库（必需，无默认可用值时才需要覆盖）============
# 应用主库；docker-compose 会覆盖成容器内地址，此处仅本机直跑时使用
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/agent_cs

# ============ LLM：OpenAI 兼容（仅 live 模式 NO_PAID_API=false 时必需）============
# 必需（live 模式）。真实 DeepSeek Key，留空 = 未配置
DEEPSEEK_API_KEY=
# 可选，默认 https://api.deepseek.com；自建网关可改，明文 http 仅允许本机地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选，默认 deepseek-v4-flash；对话/Agent 使用的模型
MODEL_NAME=deepseek-v4-flash
# 可选，默认 deepseek-v4-pro；仅评测 LLM Judge 使用
JUDGE_MODEL_NAME=deepseek-v4-pro

# ============ LLM 超时与重试（可选，均有默认值，一般不需要改）============
# 连接超时秒数，默认 10
LLM_CONNECT_TIMEOUT_SECONDS=10
# 读超时秒数，默认 60；读超时不重试（请求可能已计费），usage 按上限计入
LLM_READ_TIMEOUT_SECONDS=60
# 首次之外最多重试几次，默认 2；只重试 429 / 5xx / 连接失败 / 连接超时
LLM_MAX_RETRIES=2
# 指数退避基数秒数，默认 0.5（实际等待 = base * 2^(n-1)，封顶 LLM_RETRY_MAX_SECONDS）
LLM_RETRY_BASE_SECONDS=0.5
# 单次退避等待上限秒数，默认 8
LLM_RETRY_MAX_SECONDS=8
# 服务端 Retry-After 超过它就不在请求线程里等、直接失败，默认 20
LLM_RETRY_AFTER_MAX_SECONDS=20

# ============ 离线优先开关（必需，决定是否走真实付费 API）============
# 默认 true（离线/CI/演示）；改成 false 前必须同时配好上面的 DEEPSEEK_* 与下面的 JWT_SECRET，
# 否则启动即被 app/config.py 的 live_config_problems 拒绝
NO_PAID_API=true

# ============ Agent / 工具护栏（可选，均有默认值）============
# Agent 单轮最多推进几步，默认 8
MAX_AGENT_STEPS=8
# 只读工具自动重试上限，默认 2；副作用工具走幂等键、不自动重试
MAX_TOOL_RETRIES=2
# 单次工具调用超时秒数，默认 10
TOOL_TIMEOUT_SECONDS=10
# 生成最大 token 数，默认 1500
MAX_OUTPUT_TOKENS=1500
# 上下文最大 token 数，默认 12000
MAX_CONTEXT_TOKENS=12000

# ============ Embedding（必需二选一，决定检索质量）============
# fake（默认，CI/离线/演示，零依赖零费用）| bge（本地 BAAI/bge-small-zh-v1.5，真实语义检索）
EMBEDDING_BACKEND=fake
# 可选，默认 BAAI/bge-small-zh-v1.5；bge 后端使用的模型名
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 可选，默认空（联网从官方 huggingface.co 下载）；指定本地目录则只从该目录加载、不联网
BGE_MODEL_PATH=
# 可选，默认空 = 官方源；配置镜像地址需显式指定，不会自动猜测镜像
HF_ENDPOINT=
# 可选，默认 false；置 1/true 时完全离线，要求 BGE_MODEL_PATH 已存在本地模型
HF_HUB_OFFLINE=0
# 可选，转发给 huggingface_hub 的缓存目录环境变量，一般不需要设置
HF_HUB_CACHE=
HF_HOME=
# 可选，默认 0.22；fake 后端拒答阈值（停用字过滤后的 bigram 余弦）
RETRIEVAL_SCORE_THRESHOLD_FAKE=0.22
# 可选，默认 0.52；bge 后端拒答阈值（真实语义余弦，分布与 fake 不同）
RETRIEVAL_SCORE_THRESHOLD_BGE=0.52

# ============ 知识库版本（可选，均有默认值）============
# 启动时把「创建超过该时长且无存活连接持有导入锁」的 DRAFT/INGESTING 版本标为 FAILED，默认 10 分钟
KB_RECOVER_GRACE_MINUTES=10

# ============ 评测 Cost Guard（可选，均有默认值；仅 live 评测用到）============
# 单次 live 评测 preflight 预检软闸（美元），默认 1.00，--force 可越过
MAX_SINGLE_LIVE_EVAL_COST_USD=1.00
# 硬闸（美元），默认 2.00，任何情况不可越过
HARD_EVAL_COST_LIMIT_USD=2.00

# ============ JWT（必需，live 模式下必须显式设置非默认值）============
# 必需（live 模式）：>=32 字节随机密钥；留空/使用默认值时启动即拒绝（P1 安全闸：默认密钥公开可猜，令牌可伪造）
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# 可选，默认 HS256
JWT_ALGORITHM=HS256
# 可选，默认 720（分钟）= 12 小时
JWT_EXPIRE_MINUTES=720

# ============ 评测 / 测试专用库（不是 app/config.py 的 Settings 字段，供 pytest -m integration 与 scripts/run_eval.py 使用）============
# 集成测试库；必须是独立的测试库，库名以 _test 结尾，测试会清空业务表
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:55432/agent_cs_test
# 评测库；必须是独立库，库名以 _eval 或 _test 结尾，且不能与 DATABASE_URL 同库——评测会清空业务表，
# eval/safety.py 会在重置前逐层校验，未设置或与 DATABASE_URL 同库一律拒绝运行
# EVAL_DATABASE_URL=postgresql+psycopg://app:app@localhost:55432/agent_cs_eval
